{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@agentgraph/core": ["./packages/core/src/index.ts"],
      "@agentgraph/sdk": ["./packages/sdk/src/index.ts"],
      "@agentgraph/register": ["./packages/register/src/index.ts"]
    }
  }
}
