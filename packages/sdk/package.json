{
  "name": "@agentgraph/sdk",
  "version": "0.0.0",
  "description": "AgentGraph SDK: init(), exporter/processor wiring, and agent context API",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --shims"
  },
  "dependencies": {
    "@agentgraph/core": "*",
    "@opentelemetry/context-async-hooks": "^2.8.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-trace-base": "^2.8.0",
    "@opentelemetry/instrumentation": "^0.219.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
